void main(
	float3 in_pos,
	float4 in_col,
	float2 in_tex,
	uniform float4x4 mvp_matrix,
	uniform float2 tex_offset,
	out float4 out_pos : POSITION, 
	out float4 out_col : COLOR, 
	out float2 out_tex : TEXCOORD0)
{
	out_pos = mul(mvp_matrix, float4(in_pos, 1.0f));
	out_col = in_col;
	out_tex = in_tex + tex_offset;
}
