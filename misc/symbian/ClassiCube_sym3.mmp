TARGET ClassiCube.exe

MACRO CC_BUILD_SYMBIAN_3
MACRO SYMBIAN_OE_POSIX_SIGNALS

ARMFPU vfpv2

#ifdef ARMCC
ALWAYS_BUILD_AS_ARM
#endif

LIBRARY avkon.lib
LIBRARY featdiscovery.lib
#if !defined(WINS)
MACRO CC_GFX_BACKEND=CC_GFX_BACKEND_GL2
LIBRARY libglesv2.lib
LIBRARY libegl.lib
#else
MACRO CC_GFX_BACKEND=CC_GFX_BACKEND_GL1
LIBRARY libgles_cm.lib
#endif

SOURCEPATH .
START RESOURCE classicube.rss
HEADER
TARGETPATH \resource\apps
LANG SC
END

#include "common.mmh"