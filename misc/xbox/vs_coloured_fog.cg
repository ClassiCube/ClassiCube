void main(
	float4 in_pos : POSITION,
	float4 in_col : DIFFUSE,
	uniform float4x4 mvp,
	out float4 out_pos : HPOS,
	out float  out_fog : FOGC,
	out float4 out_col : COL0)
{
	float4 position;

	position = float4(in_pos.xyz, 1.0f);
	position = mul(position, mvp);
	position.xyz = position.xyz / position.w;
	
	out_pos = position;
	out_fog = position.w;
	out_col = in_col;
}
